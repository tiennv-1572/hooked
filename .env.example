# ---- MySQL (docker compose) ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=hooked
MYSQL_USER=hooked
MYSQL_PASSWORD=hooked
MYSQL_PORT=3307
ADMINER_PORT=8080

# ---- Next.js ----
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://hooked:hooked@127.0.0.1:3307/hooked
# Khóa ký session admin (chuỗi ngẫu nhiên ≥ 32 ký tự): openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# URL công khai của website (Open Graph, OpenAPI servers)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Số lần gửi form “Đăng ký tư vấn” tối đa mỗi IP trong 10 phút (POST /api/v1/registrations). Mặc định 5; 0 = tắt (chạy e2e)
REGISTRATION_RATE_LIMIT=5
